pipeline {
    agent { 
        docker {
        image 'docker:27.0.0'
        args '-v /var/run/docker.sock:/var/run/docker.sock'
        }}

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()  // This clears old workspace files
            }
        }
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'pwd'  // Verify we're in git repo
                sh 'ls -la'  // See what files are there
                sh 'git status'  // Confirm git is initialized

            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                script {
                    scannerHome = tool 'sonar-scanner'
                }
                withSonarQubeEnv('sq1') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }                 
            }
        }
        
        stage('Build and Push Docker Image') {
            steps {
                script {
                    // Fix docker socket permissions
                    sh 'sudo chmod 666 /var/run/docker.sock || chmod 666 /var/run/docker.sock || true'
                    
                    // Build and push Docker image directly
                    withCredentials([string(credentialsId: 'docker-credential', variable: 'DOCKER_PASSWORD')]) {
                        sh '''
                            docker build -t pantherlord/api-crisiview:latest .
                            
                            # Login to Docker Hub
                            echo ${DOCKER_PASSWORD} | docker login -u pantherlord --password-stdin
                            
                            # Push the image
                            docker push pantherlord/api-crisiview:latest
                            
                            # Cleanup
                            docker logout
                        '''
                    }
                }
            }
        }
    }
}