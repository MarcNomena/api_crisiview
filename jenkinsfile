pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375" // docker inside docker car on utilise docker pour build l'image
        // et ensuite en envoie du coup faut un autre instance de docker a part ce qui stocke jenkins lui meme
    }

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'git status'  

            }
        }
        
/*         stage('SonarQube Analysis') {
            steps {
                script {
                    scannerHome = tool 'sonar-scanner'
                }
                withSonarQubeEnv('sq1') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }                 
            }
        } */

        stage('initialize cleanup Test DB') {
            steps {
                sh '''
                    docker stop test-db || true
                    docker rm test-db || true
                '''
            }
        }

stage('Start Test Database') {
    steps {
        script {
            sh '''
                docker run -d --name test-db \
                    -p 3306:3306 \
                    -e MYSQL_ROOT_PASSWORD=root \
                    -e MYSQL_DATABASE=incident_db \
                    mysql:8.0
            '''
            
            // Wait for MySQL to be ready
            sh '''
                echo "Waiting for MySQL to be ready..."
                for i in {1..30}; do
                    if docker exec test-db mysqladmin ping -h localhost -uroot -proot --silent; then
                        echo "MySQL is ready!"
                        break
                    fi
                    echo "Waiting for MySQL... ($i/30)"
                    sleep 2
                done
            '''
        }
    }
}

stage('Integration Tests') {
    steps {
        script {
            sh 'npm install'
            
            sh '''
                DB_HOST=localhost \
                DB_PORT=3306 \
                DB_USER=root \
                DB_PASSWORD=root \
                DB_NAME=incident_db \
                npm test
            '''
        }
    }
}


        stage('Cleanup Test DB') {
            steps {
                sh '''
                    docker stop test-db || true
                    docker rm test-db || true
                '''
            }
        }

        
/*         stage('Build and Push Docker Image') {
