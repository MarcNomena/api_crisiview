pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375"
    }

    stages {
        stage('Test Docker Access') {
            steps {
                sh 'docker version'
                sh 'docker info'
            }
        }

        stage('Build Image') {
            steps {
                sh 'docker build -t myimage .'
            }
        }
    }
}
