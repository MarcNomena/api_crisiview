pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375" // docker inside docker car on utilise docker pour build l'image
        // et ensuite en envoie du coup faut un autre instance de docker a part ce qui stocke jenkins lui meme
    }

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'git status'  

            }
        }
        
         stage('SonarQube Analysis') {
            steps {
                script {
                    scannerHome = tool 'sonar-scanner'
                }
                withSonarQubeEnv('sq1') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }                 
            }
        } 


        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Start Application') {
            steps {
                sh 'npm start &'
                sleep 5   // laisse l'app démarrer
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'npm test'
            }
        }

         stage('Build and Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('', 'docker-credential') {
                        def customImage = docker.build("pantherlord/api-crisiview:latest")
                        customImage.push()
                    }
                }
            }
        } 
        stage('Deploy to VM') {
                steps {
                    sshagent(['vm-ssh']) {
                        sh '''
                            ssh -o StrictHostKeyChecking=no azureuser@20.215.232.60 "
                                docker pull pantherlord/api-crisiview:latest &&
                                docker rm -f crisiview || true &&
                                docker run -d --name crisiview \
                                    --network crisiview-net \
                                    -p 3001:3001 \
                                    -e DB_HOST=test-db \
                                    -e DB_PORT=3306 \
                                    -e DB_USER=root \
                                    -e DB_PASSWORD=root \
                                    -e DB_NAME=incident_db \
                                    pantherlord/api-crisiview:latest
                            "
                        '''
                    }
                }
            }

    }
}