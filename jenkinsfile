pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375" // docker inside docker car on utilise docker pour build l'image
        // et ensuite en envoie du coup faut un autre instance de docker a part ce qui stocke jenkins lui meme
    }

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
      stage('Test SSH to VM') {
    steps {
        sshagent(['vm-ssh']) {
            sh '''
                ssh -o StrictHostKeyChecking=no azureuser@20.215.232.60 "echo SSH OK"
            '''
        }
    }
}

    }
}