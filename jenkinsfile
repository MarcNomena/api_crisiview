pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375" // docker inside docker car on utilise docker pour build l'image
        // et ensuite en envoie du coup faut un autre instance de docker a part ce qui stocke jenkins lui meme
    }

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'git status'  

            }
        }
        
/*         stage('SonarQube Analysis') {
            steps {
                script {
                    scannerHome = tool 'sonar-scanner'
                }
                withSonarQubeEnv('sq1') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }                 
            }
        } */

        stage('initialize cleanup Test DB') {
            steps {
                sh '''
                    docker stop test-db || true
                    docker rm test-db || true
                '''
            }
        }

        stage('Create Network') {
    steps {
        sh '''
            docker network create crisiview-net || true
        '''
    }
}


stage('Start Test Database') {
    steps {
        script {
            sh '''
                docker run -d --name test-db \
                    -e MYSQL_ROOT_PASSWORD=root \
                    -e MYSQL_DATABASE=incident_db \
                    --network crisiview-net \
                    mysql:8.0

                docker start test-db
            '''

            sleep 15
        }
    }
}

stage('Attach Jenkins to Network') {
    steps {
        script {
            sh "docker network connect crisiview-net $(hostname) || true"
        }
    }
}


stage('Integration Tests') {
    steps {
        script {
            sh 'npm install'

            sh '''
                DB_HOST=test-db \
                DB_PORT=3306 \
                DB_USER=root \
                DB_PASSWORD=root \
                DB_NAME=incident_db \
                npm test
            '''
        }
    }
}




        stage('Cleanup Test DB') {
            steps {
                sh '''
                    docker stop test-db || true
                    docker rm test-db || true
                '''
            }
        }

        
/*         stage('Build and Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('', 'docker-credential') {
                        def customImage = docker.build("pantherlord/api-crisiview:latest")
                        customImage.push()
                    }
                }
            }
        } */
    }
}