pipeline {
    agent any

    environment {
        DOCKER_HOST = "tcp://dind:2375" // docker inside docker car on utilise docker pour build l'image
        // et ensuite en envoie du coup faut un autre instance de docker a part ce qui stocke jenkins lui meme
    }

    tools {
        nodejs 'Node25'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout Code') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'git status'  

            }
        }
        
/*         stage('SonarQube Analysis') {
            steps {
                script {
                    scannerHome = tool 'sonar-scanner'
                }
                withSonarQubeEnv('sq1') {
                    sh """
                        ${scannerHome}/bin/sonar-scanner
                    """
                }                 
            }
        } */

        stage('initialize cleanup Test DB') {
            steps {
                sh '''
                    docker stop mysql-crisiview || true
                    docker rm mysql-crisiview || true
                '''
            }
        }


        stage('Start Test Database') {
            steps {
                sh '''
                    docker run --name mysql-crisiview \
                        -e MYSQL_ROOT_PASSWORD=root \
                        -e MYSQL_DATABASE=incident_db \
                        -p 3306:3306 \
                        -d mysql:8.0
                '''

            sleep 15
            }
        }

        stage('Integration Tests') {
            steps {
                sh '''
                    npm install
                    npm test
                '''
            }
        }

        stage('Cleanup Test DB') {
            steps {
                sh '''
                    docker stop mysql-crisiview || true
                    docker rm mysql-crisiview || true
                '''
            }
        }

        
/*         stage('Build and Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('', 'docker-credential') {
                        def customImage = docker.build("pantherlord/api-crisiview:latest")
                        customImage.push()
                    }
                }
            }
        } */
    }
}